# ---------------------------------------------------------------------------
# Session Orchestrator — example environment variables
#
# Copy to `.env` and fill in values as needed. Do NOT commit `.env`.
# ---------------------------------------------------------------------------

# Clank Event Bus webhook URL.
#
# Session Orchestrator fires fire-and-forget POSTs to `${CLANK_EVENT_URL}/api/webhooks/events`
# from `scripts/lib/events.mjs` and `hooks/on-stop.mjs` — but ONLY when
# `CLANK_EVENT_SECRET` is also set. If unset, the default
# `https://events.example.com` (DEFAULT_EVENT_URL in scripts/lib/events.mjs)
# is used.
#
# Production deployments SHOULD set this explicitly rather than relying on the
# built-in default, so the target event bus is obvious from configuration.
# CLANK_EVENT_URL=https://events.example.com

# Bearer token for the Clank Event Bus webhook. When unset, no webhook POST is
# attempted (JSONL event logging still happens locally). Keep this secret.
# CLANK_EVENT_SECRET=

# ---------------------------------------------------------------------------
# GitLab access
# ---------------------------------------------------------------------------

# Personal access token with `read_api` or `read_repository` scope.
#
# Consumed by `scripts/lib/fetch-baseline.mjs` (pulls shared baseline files from
# the baseline project) and by the group scan in `scripts/vault-backfill.mjs`.
# When unset, baseline fetch fails closed with "GITLAB_TOKEN not set" rather
# than falling back to an unauthenticated request. Keep this secret.
# GITLAB_TOKEN=

# Ambient GitLab host used when a `glab` spawn is not explicitly pinned.
#
# Most call sites now pin the host per-repo via `glab -R <project>` (issue #839)
# precisely so this ambient value cannot silently retarget a command at the
# wrong instance. Set it only if you run a single non-default GitLab host.
# GITLAB_HOST=gitlab.example.com

# ---------------------------------------------------------------------------
# Optional tooling
# ---------------------------------------------------------------------------

# Model id recorded as the evaluated model by `/eval` (`scripts/eval-session.mjs`,
# `scripts/lib/eval/engine.mjs`). Falls back to "unknown" when unset. Not a secret.
# ANTHROPIC_MODEL=

# NOTE — npm publish auth does NOT belong in this file.
# `skills/npm-publish` reads `NPM_TOKEN` from `.env.local` (gitignored) and pipes
# it into a temporary `--userconfig` rather than the shared `.env`. See
# `skills/npm-publish/SKILL.md` and `docs/distribution/npm-publish-checklist.md`.
