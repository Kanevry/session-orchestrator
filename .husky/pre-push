#!/usr/bin/env sh
# Husky v9+ — pre-push hook (#932; tracked-tree rebuild)
#
# Wires scripts/run-quality-gate.mjs, which was fully implemented and tested
# (tests/scripts/run-quality-gate.test.mjs) but connected to nothing:
#   grep -rn "run-quality-gate" .gitlab-ci.yml .husky/ package.json  ->  0 hits.
#
# Why the FULL gate and not the incremental one:
#   run-quality-gate exposes four variants, but only `full-gate` can block.
#   scripts/lib/gates/gate-incremental.mjs ends in an unconditional
#   `process.exit(0)` — it is a REPORTING variant by design, so a pre-push built
#   on it would print failures and push anyway. That is the exact fail-open
#   shape this hook exists to remove, so it must not be the mechanism that
#   enforces it. `gate-full.mjs` ends in `process.exit(failed ? 2 : 0)`: a real
#   exit-code contract, pinned by tests, and immune to any change in the JSON
#   payload's shape.
#
# ---------------------------------------------------------------------------
# Why the gate runs against a MATERIALISED TRACKED TREE, not the working tree
# ---------------------------------------------------------------------------
# The first version of this hook ran `npm run quality-gate` in place. That gates
# the WORKING tree; CI gates the TRACKED tree. Everything that exists locally but
# is not committed — an untracked helper a test imports, a gitignored data file a
# test reads — is present for the local gate and absent for CI. The local gate is
# then green on a tree CI cannot build, which is the single most expensive shape
# of failure this repo has recorded (see
# .claude/rules/anti-pattern-a-green-quality-gate-on-the-development-platform-... ).
#
# So: clone the tracked tree for the sha actually being pushed into a temp dir and
# run the gate there. The tree is the one `git clone` gives CI, minus node_modules
# (see the ceilings below).
#
# `git clone --no-hardlinks` and not `git archive`, measured rather than assumed:
#   git archive HEAD | tar -x   ->  0.32 s, 1609 files, NO .git
#   git clone --no-hardlinks    ->  1.04 s, 1609 files, full .git
# `archive` is 0.7 s cheaper and unusable: without .git, 23 tests across 12 files
# fail on `fatal: not a git repository` (measured 2026-08-19 on the full suite).
# `--no-hardlinks` costs nothing over the hardlinking default (1.04 s vs 1.11 s)
# and buys total object-store isolation from the real repo.
#
# ---------------------------------------------------------------------------
# CEILINGS — what this deliberately does NOT catch (.claude/rules/build-value.md BV-004)
# ---------------------------------------------------------------------------
#   1. LOCKFILE / DEPENDENCY DRIFT. node_modules is SYMLINKED from the working
#      copy, because `npm ci` in the temp tree would cost far more than the gate
#      itself. So a dependency added to package.json but never installed, or an
#      installed tree that has drifted from package-lock.json, stays invisible
#      here — CI's fresh `npm ci` is the only thing that catches it.
#      Revisit trigger: the first lockfile-drift red on CI that this hook let past.
#   2. PLATFORM. This runs on the pusher's machine (macOS), CI runs Linux. It
#      cannot see a Linux-only break: the unset-vs-trailing-slash $TMPDIR class
#      and the ARG_MAX / spawnSync E2BIG class are both documented incidents in
#      this repo. `env -u TMPDIR` locally is the partial substitute; the real
#      answer stays "read the CI job".
#      Revisit trigger: a second platform-only red after this hook shipped.
#   3. ONE REF. A multi-ref push materialises only the FIRST content-bearing
#      local_sha; the rest are announced as ungated on stderr. Gating N refs
#      would cost N x ~60 s, which buys back the reflex bypass this hook spends
#      its whole design budget avoiding.
#      Revisit trigger: a real multi-ref push shipping a break in ref 2+.
#   4. COST -> BYPASS PRESSURE. Materialisation adds ~1 s to a gate that already
#      warns about ~2 min of silence. That is small in seconds and not small in
#      temperament: every second added here raises the pull toward
#      SKIP_QUALITY_GATE, which is why the bypass stays named and loud rather
#      than being removed.
#   5. ONE UNLISTED PUBLISH HOST (#C10). The scratch-vs-publish check below
#      trusts exactly two signals: a configured remote NAME/URL, and the
#      literal substring `github.com` or the host of `origin`'s URL. A URL
#      push to a THIRD real publish endpoint this repo has never configured
#      here — a second GitHub org, an unregistered self-hosted mirror — reads
#      as scratch and skips the gate. Not closable without enumerating every
#      publish endpoint, which is exactly the config surface BV-001 forbids
#      adding on spec.
#      Revisit trigger: a real push to an unlisted publish host that should
#      have gated.
#
# Two things keep the cost from turning into a reflex `--no-verify`:
#   - a delete-only push changes no code and is skipped BEFORE any clone happens;
#   - SKIP_QUALITY_GATE=1 is a named, greppable, loudly-announced bypass.
#     Prefer it over `git push --no-verify`, which disables EVERY hook silently,
#     including any future one, and leaves no trace of what was skipped.
#
# Skipped silently when the gate script is absent (vendored-hook consumers,
# test fixtures) — mirrors the gitleaks not-installed skip in .husky/pre-commit.

if [ ! -f scripts/run-quality-gate.mjs ]; then
  exit 0
fi

if [ -n "$SKIP_QUALITY_GATE" ]; then
  echo "⚠ pre-push: quality gate BYPASSED via SKIP_QUALITY_GATE — nothing was verified." >&2
  exit 0
fi

# ---------------------------------------------------------------------------
# Scrub git's own repo-pointing environment — BEFORE the first git call
# ---------------------------------------------------------------------------
# git's own environment OUTRANKS both the `-C <path>` flag and cwd. A hook that
# materialises a second tree and then runs git "in" it is therefore still talking
# to the ORIGINAL repository for as long as any of these survive.
#
# MEASURED on git 2.x / macOS, 2026-08-19 — do not reason about this, it is
# counter-intuitive in both directions:
#   - GIT_DIR is NOT set for pre-push, pre-commit, commit-msg or post-commit.
#     It is unset here as defence in depth (other git versions and other drivers
#     do export it), NOT because this hook observes it.
#   - GIT_INDEX_FILE IS set for the commit family, and its value is the RELATIVE
#     `.git/index` — which re-resolves against whatever directory a child happens
#     to run in. That is exactly the shape that goes wrong quietly.
#   - GIT_CONFIG_PARAMETERS is set whenever ANY `-c key=value` was passed, and it
#     propagates into every child. It is what actually broke this hook: a
#     `git -c core.hooksPath=.husky push` carried that override into the
#     materialised clone, where `.husky/` exists — so every throwaway git repo the
#     gate's own suite creates fired the REPOSITORY's real pre-commit hooks.
#     Result: `test: fail, total: 0` on three consecutive pushes, green the moment
#     the flag was dropped.
#   - GIT_CONFIG_COUNT / GIT_CONFIG_KEY_n / GIT_CONFIG_VALUE_n is the ENUMERATED
#     form of the same command-line config channel, and it is INDEPENDENT of
#     GIT_CONFIG_PARAMETERS — neither gates the other. Measured 2026-08-19 in a
#     throwaway /tmp repo: with GIT_CONFIG_COUNT=1 / KEY_0=core.hooksPath /
#     VALUE_0=<dir> a `git commit` fired the foreign hook; the identical commit
#     without them did not. A name list that stopped at GIT_CONFIG_PARAMETERS
#     therefore left the exact same door open under a different handle.
#
# SO THIS IS A NAMESPACE SWEEP, NOT A NAME LIST — and that is the whole point.
# Every list-shaped version of this block has shipped with a hole in it: the
# first named GIT_DIR but not GIT_CONFIG_PARAMETERS, the second named
# GIT_CONFIG_PARAMETERS but not its enumerated sibling. `hooks/_lib/guard-source-loader.mjs`
# reached the same verdict from the other direction and solved it with an
# ALLOWLIST child env — which it can do because it builds the environment for one
# `execFileSync` git child. This hook cannot: it scrubs its OWN shell, whose
# children are npm, node and the entire test suite, so `env -i` is not on the
# table. The middle form is an allowlist scoped to the GIT_ NAMESPACE — sweep
# everything git could read, keep a short justified set. A channel a future git
# release adds will be GIT_* too, so it is closed before it is named.
#
# THE KEEP-SET, and why each entry is safe. Every kept name answers WHO, WHEN or
# HOW; none answers WHICH REPOSITORY or WHICH CONFIG, which is the only axis that
# can redirect this hook:
#   - GIT_AUTHOR_* / GIT_COMMITTER_* — identity and dates. They change the
#     attribution of a fixture commit, never its destination.
#   - GIT_EDITOR — measured, and NOT hygiene: Claude Code exports GIT_EDITOR=true
#     precisely so git never blocks on an editor, and EDITOR is empty here.
#     Sweeping it makes git fall back to `vi`, so any git call that wants an
#     editor HANGS the gate behind ~2 min of expected silence. Keeping it removes
#     a hang class and closes nothing.
#   - GIT_ASKPASS / GIT_SSH / GIT_SSH_COMMAND / GIT_TERMINAL_PROMPT — credential
#     and transport plumbing. Removing them turns an auth prompt into a hang for
#     the same no gain.
#   - GIT_EXEC_PATH — where git's OWN helper programs live, not where a repository
#     lives. Measured 2026-08-19 by dumping the environment from a real pre-push
#     hook in a throwaway /tmp repo: git exports exactly GIT_EDITOR, GIT_EXEC_PATH
#     and GIT_PREFIX. GIT_PREFIX is a location and is swept; GIT_EXEC_PATH is kept
#     because dropping it makes a child git fall back to its compiled-in libexec,
#     which is wrong on a relocated or portable install and buys nothing — it can
#     name no repository and inject no config.
#
# Unsetting is safe: git invokes a pre-push hook with cwd at the top of the work
# tree, so ordinary discovery finds the same repository these variables named.
# It is also local: the `git push` that spawned this hook already forked, so the
# push's own transport runs in the parent and cannot be affected by these unsets.
# This block must stay ABOVE every `git` invocation in this file — moving a git
# call above it silently re-opens the hole.
#
# POSIX-sh notes: `grep -E` (not sed's `\|`, a GNU-only BRE extension that BSD
# sed on the pusher's macOS does not support); the `case` pattern carries a
# leading paren for bash 3.2; and `unset` on an absent name is a no-op, so a
# stray match costs nothing.
git_env_keep=' GIT_EXEC_PATH GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE GIT_EDITOR GIT_ASKPASS GIT_SSH GIT_SSH_COMMAND GIT_TERMINAL_PROMPT '
for git_var in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | grep -E '^GIT_'); do
  case "$git_env_keep" in
    (*" $git_var "*) continue ;;
  esac
  unset "$git_var"
done
unset git_var git_env_keep

# ---------------------------------------------------------------------------
# PUBLISH push vs. SCRATCH push (#C10) — read BEFORE the ref loop, right after
# the git-env scrub above (this block's own `git remote` calls must sit below
# that scrub, same reasoning as the materialisation `git` calls further down).
# ---------------------------------------------------------------------------
# git invokes pre-push with $1 = the remote NAME (or its URL, when pushed BY
# URL) and $2 = the remote URL — this hook never read either until now
# (`rg -n '\$1|\$2' .husky/pre-push` found only a local function's own args,
# in link_node_modules()). A SCRATCH push — a raw, unconfigured URL such as
# the remote-offload tool's SSH sync target — publishes nothing: gating it
# buys no safety and costs the full quality gate on every sync. (The offload
# tool has since been fixed upstream to push with --no-verify; this check is
# defense-in-depth and precedent, not the primary fix.)
#
# Empty $1 (every hand invocation, every pre-#C10 test) takes neither branch
# below and leaves so_scratch=0 — NOT scratch, so existing behaviour is
# unchanged: it still fails TOWARD gating.
so_scratch=0
if [ -n "$1" ]; then
  if git remote 2>/dev/null | grep -qFx -- "$1"; then
    so_scratch=0
  else
    # $1 names no configured remote — candidate scratch. Two escape hatches
    # keep a URL-form publish push (`git push https://github.com/...`, where
    # $1 is never a remote NAME) gated anyway — see CEILINGS #5 for what
    # they deliberately do not cover.
    so_scratch=1
    for so_remote in $(git remote 2>/dev/null); do
      so_remote_url=$(git remote get-url --all "$so_remote" 2>/dev/null) || so_remote_url=''
      if printf '%s\n' "$so_remote_url" | grep -qFx -- "$2"; then
        so_scratch=0
        break
      fi
    done
    if [ "$so_scratch" -eq 1 ]; then
      case "$2" in
        (*github.com*) so_scratch=0 ;;
      esac
    fi
    if [ "$so_scratch" -eq 1 ]; then
      so_origin_url=$(git remote get-url origin 2>/dev/null) || so_origin_url=''
      if [ -n "$so_origin_url" ]; then
        so_origin_host=$(printf '%s\n' "$so_origin_url" | sed -n 's#.*://##; s#.*@##; s#[:/].*##p')
        case "$2" in
          (*"$so_origin_host"*) so_scratch=0 ;;
        esac
      fi
    fi
  fi
fi

if [ "$so_scratch" -eq 1 ]; then
  so_target_host=$(printf '%s\n' "$2" | sed -n 's#.*://##; s#.*@##; s#[:/].*##p')
  echo "pre-push: scratch push to ${so_target_host:-<unknown host>} (not a configured remote) — quality gate skipped; publish remotes (origin, github) still gated." >&2
  exit 0
fi
unset so_scratch so_remote so_remote_url so_origin_url so_origin_host so_target_host

# git feeds one line per pushed ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# An all-zero local sha means the ref is being DELETED. A push that only deletes
# refs ships no code, so gating it is pure latency with no signal. This loop runs
# BEFORE any materialisation: a delete-only push must not pay for a clone either.
zero='0000000000000000000000000000000000000000'
has_content=0
content_refs=0
target_sha=''
target_ref=''
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue
  has_content=1
  content_refs=$(( content_refs + 1 ))
  if [ -z "$target_sha" ]; then
    target_sha=$local_sha
    target_ref=$local_ref
  fi
done

if [ "$has_content" -eq 0 ]; then
  echo "pre-push: delete-only push — quality gate skipped." >&2
  exit 0
fi

# ---------------------------------------------------------------------------
# Materialise the tracked tree
# ---------------------------------------------------------------------------
# `work` is the parent temp dir; the clone lands in $work/tree. The trap owns its
# removal so a failing gate, a Ctrl-C, or a kill cannot leave ~1600 files behind
# per push. cleanup() is idempotent (it blanks `work`), so the INT/TERM handlers
# chaining into EXIT cannot double-remove.
work=''
cleanup() {
  [ -n "$work" ] || return 0
  case "$work" in
    (/*) rm -rf "$work" ;;
  esac
  work=''
}
trap 'cleanup' EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || repo_root=''

if [ -z "$repo_root" ]; then
  # Unreachable during a real `git push` — git only runs this hook from inside a
  # work tree. The path exists so a non-repo invocation (test fixtures, a vendored
  # consumer driving the hook by hand) degrades to the previous working-tree
  # behaviour LOUDLY rather than failing shut. A silent degrade here would be the
  # worst of both worlds: a gate that proves nothing and says nothing.
  echo "⚠ pre-push: not inside a git work tree — gating the WORKING TREE instead." >&2
  echo "            This does NOT prove the tracked tree builds." >&2
  run_dir=$(pwd)
  tree_label='working tree'
else
  work=$(mktemp -d)
  if [ -z "$work" ] || [ ! -d "$work" ]; then
    echo "✗ pre-push: could not create a temp dir for the tracked-tree gate. Push blocked." >&2
    echo "  Bypass (only after triaging): SKIP_QUALITY_GATE=1 git push" >&2
    exit 1
  fi
  tree=$work/tree
  short_sha=$(printf '%.12s' "$target_sha")

  mat_start=$(date +%s)
  if ! git clone --quiet --no-hardlinks "$repo_root" "$tree" 2>&1; then
    # Fail CLOSED. A gate that could not be set up has verified nothing, which is
    # the exact failure class this hook exists for.
    echo "✗ pre-push: could not materialise the tracked tree from $repo_root. Push blocked." >&2
    echo "  Bypass (only after triaging): SKIP_QUALITY_GATE=1 git push" >&2
    exit 1
  fi
  if ! git -C "$tree" checkout --quiet --detach "$target_sha" 2>&1; then
    echo "✗ pre-push: $short_sha ($target_ref) is not reachable in the cloned tree." >&2
    echo "  Push blocked — the gate cannot verify a commit it cannot check out." >&2
    echo "  Bypass (only after triaging): SKIP_QUALITY_GATE=1 git push" >&2
    exit 1
  fi

  # `git clone <path>` points the clone's `origin` at a FILESYSTEM PATH. CI's checkout
  # points it at the real remote URL, and code that PARSES that URL therefore behaves
  # differently in the two trees — which is the opposite of what this hook is for.
  # Measured 2026-08-19 on the first real run: deriveRepo() (vault-mirror/namespace.mjs)
  # matches an `org/name` shape, so it yields "session-orchestrator" in the working copy
  # and on CI, but "unknown-repo" against a path-shaped origin — blocking a push over an
  # artefact of the materialisation. Carry the real URL over so the clone is CI-faithful.
  # Best-effort: a repo with no origin (fresh `git init`) simply keeps the path form,
  # which is the same shape it already has in the working copy.
  origin_url=$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)
  if [ -n "$origin_url" ]; then
    git -C "$tree" remote set-url origin "$origin_url" 2>/dev/null || true
  fi

  # A symlink is a FILE to git, so the `node_modules/` line in .gitignore does not
  # match it. Without this exclude the fresh clone reports a dirty tree and every
  # cleanliness assertion in the suite goes red on an artefact of this hook. The
  # bare pattern matches at any depth, so it covers the nested link below too.
  printf 'node_modules\n' >> "$tree/.git/info/exclude"

  # CI parity, and it is TWO links, not one: .gitlab-ci.yml and
  # .github/workflows/test.yml both run `npm ci` AND
  # `(cd skills/vault-sync && npm install)`. Measured 2026-08-19 on the full
  # suite: linking only the root gives `9 test files failed | 102 tests failed`
  # against `1 file | 0 tests` with both links, the extra ones all on
  # `Cannot find package 'zod' imported from skills/vault-sync/validator.mjs`.
  # That is an artefact of this setup, not a defect in the tree being pushed.
  link_node_modules() {
    nm_src=$repo_root${1:+/$1}/node_modules
    nm_dst=$tree${1:+/$1}/node_modules
    [ -d "$nm_src" ] || return 0
    [ -d "$tree${1:+/$1}" ] || return 0
    [ -e "$nm_dst" ] && return 0
    ln -s "$nm_src" "$nm_dst" 2>/dev/null || return 0
  }
  link_node_modules ''
  link_node_modules 'skills/vault-sync'

  mat_elapsed=$(( $(date +%s) - mat_start ))
  run_dir=$tree
  tree_label="tracked tree @ $short_sha"
  echo "pre-push: materialised the tracked tree in ${mat_elapsed}s ($short_sha)." >&2
  if [ "$content_refs" -gt 1 ]; then
    echo "⚠ pre-push: $content_refs content-bearing refs pushed — only $target_ref is gated." >&2
  fi
fi

echo "pre-push: running the full quality gate (typecheck + tests + lint)" >&2
echo "          against the $tree_label — NOT your working copy." >&2
echo "          Output is buffered by the gate, so expect ~2 min of silence." >&2
echo "          Bypass with SKIP_QUALITY_GATE=1 (never silently with --no-verify)." >&2

start=$(date +%s)
# The subshell keeps the cd and the unsets local, so the EXIT trap above still
# sees the parent's $work.
#
# The unsets are load-bearing, not hygiene. scripts/lib/platform.mjs
# resolveProjectDir() and scripts/lib/plugin-root.mjs resolvePluginRoot() consult
# these BEFORE walking up from cwd. Claude Code sets CLAUDE_PROJECT_DIR to the
# real repo, so leaving one set makes the gate start in the temp tree and resolve
# its files back to the working copy — green while proving nothing, the precise
# way a rebuild like this goes quietly useless.
#
# SUFFIX SWEEP, for the same reason the GIT_ block above is a namespace sweep:
# the hand-written list here covered SIX of the NINE names the two resolvers
# actually read, and the three it missed are not the ones anyone would guess.
#   - CURSOR_PROJECT_DIR — the fourth platform in the resolveProjectDir chain
#     (platform.mjs), simply absent from the list.
#   - PLUGIN_ROOT — the bare native name, and it is rung ONE of resolvePluginRoot,
#     i.e. it outranks every CLAUDE_/CODEX_/PI_ name the old list did unset.
#   - CURSOR_RULES_DIR — the Cursor plugin root is NOT called CURSOR_PLUGIN_ROOT.
#     Extending the list by the guessed name would have read as a complete fix in
#     review and closed nothing at all.
# Measured 2026-08-19: with CURSOR_PROJECT_DIR set, SO_PROJECT_DIR resolves to the
# WORKING COPY from a foreign cwd — and that is a WRITE channel, not a path
# string: scripts/lib/events.mjs eventsFilePath() defaults to SO_PROJECT_DIR and
# run-quality-gate.mjs emitEvent() appends through it, so the temp-tree gate would
# write telemetry back into the tree it exists to stay out of.
#
# The sweep is by SUFFIX (…PROJECT_DIR / …PLUGIN_ROOT / …RULES_DIR, which also
# catches the bare PLUGIN_ROOT), so a fifth platform added to platform.mjs is
# covered before anyone edits this file. What it does NOT cover is a location var
# with a novel suffix (a hypothetical FOO_WORKSPACE) — that gap is held by
# tests/husky/pre-push-tracked-tree.test.mjs, which derives the name census from
# the two resolver modules and goes RED on exactly that case.
# SO_PLATFORM is deliberately KEPT: it only reorders the compatibility roots and
# names no path, so with every root swept it is inert — and scrubbing it would
# change which platform the gate believes it runs on, a behaviour change with no
# safety gain.
#
# `npm run --silent` keeps package.json as the single definition of the gate
# command and drops npm's own ERR! banner; the child's exit code is forwarded.
(
  cd "$run_dir" || exit 1
  for root_var in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | grep -E 'PROJECT_DIR$|PLUGIN_ROOT$|RULES_DIR$'); do
    unset "$root_var"
  done
  unset root_var
  npm run --silent quality-gate
)
status=$?
elapsed=$(( $(date +%s) - start ))

if [ "$status" -ne 0 ]; then
  # exit 2 = a gate failed; exit 1 = the gate itself could not run. Both block:
  # a gate that cannot run has not verified anything, which is the failure class
  # this hook exists for.
  echo "✗ pre-push: quality gate FAILED (exit $status) after ${elapsed}s. Push blocked." >&2
  echo "  It ran against the $tree_label, so untracked and gitignored files were" >&2
  echo "  INVISIBLE to it — that is the point, and it is the usual reason a failure" >&2
  echo "  here does not reproduce with a bare \`npm run quality-gate\`." >&2
  echo "  First thing to check:  git status --short" >&2
  echo "  Bypass (only after triaging): SKIP_QUALITY_GATE=1 git push" >&2
  exit 1
fi

echo "✓ pre-push: quality gate passed in ${elapsed}s against the $tree_label." >&2
