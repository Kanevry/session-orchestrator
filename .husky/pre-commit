#!/usr/bin/env sh
# Husky v9+ — pre-commit hook
#
# Blocking stages, fail-fast:
#   1. check-package-manager (#715) — package-manager recurrence guard. Fires
#      HERE (not via npm's `preinstall`/`pretest` lifecycle hooks) because
#      this repo's `.npmrc` sets `ignore-scripts=true` (SEC-020), which makes
#      npm silently skip lifecycle hooks — a git-native hook is the only
#      place this guard reliably fires before a commit lands. Cheapest check
#      (Node-stdlib-only, no deps needed), so it runs first.
#   2. nul-byte-guard (K7) — reject NUL bytes in staged TEXT files. Binary
#      corruption of a source file survives BOTH vitest and eslint; git's
#      "Bin" diff marker is the only cheap signal, so this gate reads the
#      staged BLOBS (`git show :<path>`), never the worktree copies.
#   3. gitleaks (#350) — scan staged changes for secrets.
#      Skipped silently if gitleaks is not installed locally
#      (CI still runs it via gitleaks-scan job in .gitlab-ci.yml).
#   4. check-owner-leakage (#494) — scan tracked files for P1–P7 owner-privacy
#      leakage (personal paths, private GitLab host, private slugs, etc.). The
#      scanner reads via `git ls-files`, which sees staged-but-not-committed
#      files — closing the gap where `git add <leak> && git commit` slipped
#      through 3× before (deep-1, deep-2, deep-3). Reuses the same scanner CI
#      runs in the owner-leakage validate job, so local/CI parity is exact.
#   5. hook-import-set-drift (#1224) — the committed hook-reachable allowlist
#      must match a fresh crawl. Runs ONLY when the staged set touches
#      hooks/ or scripts/lib/. Reads the WORKTREE (the generator crawls files,
#      not index blobs) — acceptable here because the artefact it guards is
#      itself regenerated from the worktree.
#   6. check-test-fixture-shapes (#556) — live-credential shapes in tests/.
#   7. lint-staged (#352) — eslint --fix on staged *.mjs.
# Plus one ADVISORY (never blocking) stage: check-test-value-bans over staged
# test files only.
# Skipped silently when the guard script is absent (vendored-hook consumers,
# test fixtures) — mirrors the gitleaks not-installed skip in stage 3.
if [ -f scripts/check-package-manager.mjs ]; then
  node scripts/check-package-manager.mjs >/dev/null 2>&1 || {
    echo "✗ check-package-manager: package-manager drift detected (see #715). Commit blocked." >&2
    echo "  Run \`node scripts/check-package-manager.mjs\` for details." >&2
    echo "  Use 'git commit --no-verify' to bypass (only after triaging)." >&2
    exit 1
  }
fi

# --- nul-byte-guard:begin (K7) ---
# NUL bytes in a staged TEXT file mean silent binary corruption: it survives
# vitest AND eslint, and only git's "Bin" diff marker hints at it. Block here.
# SUBJECT = THE STAGED BLOB, never the worktree copy: `git show ":$f"` reads
# the index, so `git add <corrupt>` followed by a worktree repair cannot smuggle
# corruption past this gate, and an unrelated dirty worktree cannot false-block.
# Portability: `tr -d '\000' | wc -c` is POSIX and works on BSD/macOS + GNU.
# `grep -P '\x00'` is GNU-only, `$'\x00'` is a bashism dash cannot parse, and
# `cmp - <(git show ...)` is a bash process substitution — all three silently
# degrade this gate to a no-op under `sh`. Do not "simplify" here.
# The tests/husky/ suite EXECUTES this exact block between the markers.
nul_hits=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -Ei '\.(mjs|cjs|js|mts|ts|md|json|ya?ml|sh|txt)$' \
  | while IFS= read -r f; do
      # Allowlist — path-exact (NO globs) files whose NUL bytes are DELIBERATE.
      # Verified 2026-07-29 as the complete set: the detection expression below,
      # run over `git ls-files`, matches exactly these two. Both are TEST
      # FIXTURES, where a raw NUL is the payload under test.
      #
      # PRODUCTION CODE IS DELIBERATELY NOT ALLOWLISTED — hooks/config-protection.mjs
      # was removed from this list on 2026-07-29. Its masking sentinel now uses the
      # escaped form ('\0'.repeat(...)), which is byte-identical at runtime but
      # keeps the file TEXT on disk. Rationale: one raw NUL makes a file binary to
      # ugrep / `grep -I` (Claude Code's Grep tool), which then skips it SILENTLY —
      # a live deny-path census missed that security hook's emitDeny call exactly
      # that way. Do not re-add a production file here; fix the source instead.
      # Reasons for the two that remain:
      #   nul-allowed tests/lib/config/dispatcher-autonomy.test.mjs —
      #     adversarial fixture: asserts the config parser survives a
      #     NUL/control-byte garbage payload (~L222).
      #   nul-allowed tests/scripts/lib/frontend-detect/detect.test.mjs —
      #     adversarial fixture: asserts frontend-detect survives a
      #     50-NUL-prefixed pathological input string (~L219).
      # The leading `(` on each pattern is REQUIRED, not decoration: bash 3.2
      # (macOS /bin/sh) mis-parses a bare `pattern)` inside `$( ... )` as the
      # end of the command substitution — "syntax error near unexpected token
      # `;;'". The `(pattern)` form is POSIX and parses everywhere.
      case "$f" in
        (tests/lib/config/dispatcher-autonomy.test.mjs) continue ;;
        (tests/scripts/lib/frontend-detect/detect.test.mjs) continue ;;
      esac
      raw=$(git show ":$f" | wc -c | tr -cd '0-9')
      stripped=$(git show ":$f" | LC_ALL=C tr -d '\000' | wc -c | tr -cd '0-9')
      [ "$raw" = "$stripped" ] || printf '%s\n' "$f"
    done)
if [ -n "$nul_hits" ]; then
  echo "✗ nul-byte-guard: NUL byte(s) in staged text file(s). Commit blocked." >&2
  printf '%s\n' "$nul_hits" | sed 's/^/    /' >&2
  echo "  Binary corruption survives vitest + eslint — recover the file with" >&2
  echo "  \`git show HEAD:<file> > <file>\` (NOT 'git checkout --', see PSA-003)," >&2
  echo "  then re-stage it: the STAGED blob is what this gate reads." >&2
  echo "  Use 'git commit --no-verify' to bypass (only after triaging)." >&2
  exit 1
fi
# --- nul-byte-guard:end ---

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner --config .gitleaks.toml || {
    echo "✗ gitleaks: secret detected in staged changes. Commit blocked." >&2
    echo "  Use 'git commit --no-verify' to bypass (only after triaging)." >&2
    exit 1
  }
fi

node scripts/lib/validate/check-owner-leakage.mjs "$(git rev-parse --show-toplevel)" >/dev/null 2>&1 || {
  echo "✗ check-owner-leakage: privacy leak detected in tracked files. Commit blocked." >&2
  echo "  Run \`node scripts/lib/validate/check-owner-leakage.mjs .\` for details." >&2
  echo "  Use 'git commit --no-verify' to bypass (only after triaging)." >&2
  exit 1
}

# --- hook-import-set-drift:begin (#1224) ---
# The committed hook-reachable allowlist (hooks/_lib/hook-import-set.json) is
# what gates hooks/post-edit-import-probe.mjs. A stale allowlist silently
# NARROWS that probe: a module that just BECAME hook-reachable is edited without
# ever being checked — the 2026-09-04 incident shape, where a broken helper made
# every Bash/Edit/Write call fail host-wide for ~8 minutes.
# Scoped to commits that touch hooks/ or scripts/lib/ — the only two trees the
# crawl reads — so an unrelated docs commit never pays the crawl cost.
# `grep -q` alone decides the gate; no `grep -c` counting (see
# .claude/rules/bash-harness-pitfalls.md § 1).
if [ -f scripts/generate-hook-import-set.mjs ] &&
   git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(hooks|scripts/lib)/'; then
  # A silent exit 0 is NOT a pass: if the generator's CLI entry guard does not
  # fire (symlinked/realpath-differing invocation), the whole body is a no-op
  # that still exits 0 — a fail-OPEN gate. Demand the success MARKER, exactly
  # as scripts/validate-plugin.mjs runHookImportSetCheck() does.
  his_out=$(node scripts/generate-hook-import-set.mjs --check 2>&1) || true
  case "$his_out" in
    (*"modules, in sync"*) : ;;
    (*)
      echo "✗ hook-import-set: committed allowlist is stale (see #1224). Commit blocked." >&2
      echo "  run node scripts/generate-hook-import-set.mjs and stage hooks/_lib/hook-import-set.json" >&2
      echo "  Use 'git commit --no-verify' to bypass (only after triaging)." >&2
      [ -n "$his_out" ] && echo "  generator said: $his_out" >&2
      exit 1
      ;;
  esac
fi
# --- hook-import-set-drift:end ---

# check-test-fixture-shapes (#556) — scan tracked tests/**/*.{mjs,ts,js} for
# live-credential shapes (sk_live_, xoxb-<digits>, AKIA…, AIzaSy…) that would
# block a public GitHub-mirror push. Uses the same git ls-files enumeration
# pattern as check-owner-leakage, so staged-but-not-committed test fixtures
# are caught before they land on a public branch.
node scripts/lib/validate/check-test-fixture-shapes.mjs "$(git rev-parse --show-toplevel)" >/dev/null 2>&1 || {
  echo "✗ check-test-fixture-shapes: live-credential pattern detected in tests/. Commit blocked." >&2
  echo "  Run \`node scripts/lib/validate/check-test-fixture-shapes.mjs .\` for details." >&2
  echo "  Use \`// @secret-shape-allowed\` magic comment on the fixture file to allowlist intentional cases." >&2
  echo "  Or 'git commit --no-verify' to bypass (only after triaging)." >&2
  exit 1
}

# --- test-value-bans-advisory:begin ---
# ADVISORY ONLY — never blocks (warn-only v1). Scans just the STAGED test
# files (not the whole corpus) for the two lint-enforceable test bans from
# .claude/rules/testing.md § "Lint-Enforceable Test Bans": exact count
# assertions on dynamic sets, and suspected .md prose pins.
if [ -f scripts/lib/validate/check-test-value-bans.mjs ]; then
  git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^tests/.*\.test\.mjs$' \
    | node scripts/lib/validate/check-test-value-bans.mjs --stdin --quiet || true
fi
# --- test-value-bans-advisory:end ---

npx lint-staged

# PSA-004 sub-mode B: commit-time wave-scope guard (runs AFTER lint-staged
# re-stages files). See .claude/rules/parallel-sessions.md and #495.
node hooks/wave-scope-commit-guard.mjs || exit 1
